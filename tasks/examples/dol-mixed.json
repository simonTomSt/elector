    { "id": "m2", "group": "Okablowanie zgodne ze schematem", "text": "Szafa odpowiada schematowi", "check": "schematicMatchesCabinet" },
    { "id": "m3", "group": "Okablowanie zgodne ze schematem", "text": "Kolory przewodów", "check": "wireColors" },
    { "id": "m4", "group": "Test", "text": "START → -K1 → -M1 pracuje", "check": "scenario", "args": { "id": "start-stop" } }
  ],
  "uiHints": { "defaultView": "split", "schematicReadOnly": true, "syncSelection": true }
