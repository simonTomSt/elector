{
  "id": "diag-contact-stuck",
  "extends": "dol-4kw",
  "type": "diagnostic",
  "title": "Silnik nie zatrzymuje się po STOP",
  "level": "średni",
  "durationMin": 15,
  "statement": "Operator naciska STOP, ale silnik dalej pracuje. Znajdź usterkę mechaniczną aparatu, przestrzegając LOTO przed dotknięciem.",
  "symptom": "„Po naciśnięciu -S1 STOP styki głównego stycznika -K1 nadal zasilają silnik. Lampka -H1 też się nie gasi.”",
  "scene": { "start": "wired", "supply": "-Q0" },
  "faults": [
    { "id": "f-k1-welded", "label": "Zgrzane styki główne -K1 (NO blokują się zamknięte)", "apply": { "device": "-K1", "deviceFault": "contactWelded" } },
    { "id": "f-s1-welded", "label": "Zablokowany przycisk STOP -S1 (styki NC blokują się zamknięte)", "apply": { "device": "-S1", "deviceFault": "contactWelded" } },
    { "id": "f-k1-coilopen", "label": "Przerwa cewki -K1 (coil się nie wyłącza bo się nie włączyła)", "apply": { "device": "-K1", "deviceFault": "coilOpen" } }
  ],
  "pickFaults": 1,
  "requirements": [
    { "id": "d1", "text": "LOTO przed pracą na okablowaniu", "check": "scenario", "args": { "id": "loto-order" } },
    { "id": "d2", "text": "Objaw: po STOP silnik dalej pracuje przy zgrzanych stykach -K1", "check": "scenario", "args": { "id": "weld-symptom-k1" } }
  ],
  "testScenarios": [
    {
      "id": "weld-symptom-k1", "name": "Objaw usterki f-k1-welded",
      "steps": [
        { "do": "set", "tag": "@fault", "state": { "id": "f-k1-welded" } },
        { "do": "set", "tag": "-Q0", "state": { "on": true } },
        { "do": "set", "tag": "-Q1", "state": { "on": true } },
        { "do": "set", "tag": "-F1", "state": { "on": true } },
        { "do": "wait", "ms": 200 },
        { "do": "press", "tag": "-S2", "ms": 200 },
        { "do": "wait", "ms": 1000 },
        { "expect": { "-M1.running": true } },
        { "do": "press", "tag": "-S1", "ms": 200 },
        { "do": "wait", "ms": 200 },
        { "expect": { "-M1.running": true, "-H1.lit": true } }
      ]
    },
    {
      "id": "weld-symptom-s1", "name": "Objaw usterki f-s1-welded",
      "steps": [
        { "do": "set", "tag": "@fault", "state": { "id": "f-s1-welded" } },
        { "do": "set", "tag": "-Q0", "state": { "on": true } },
        { "do": "set", "tag": "-Q1", "state": { "on": true } },
        { "do": "set", "tag": "-F1", "state": { "on": true } },
        { "do": "wait", "ms": 200 },
        { "do": "press", "tag": "-S2", "ms": 200 },
        { "do": "wait", "ms": 1000 },
        { "expect": { "-M1.running": true } },
        { "do": "press", "tag": "-S1", "ms": 200 },
        { "do": "wait", "ms": 200 },
        { "expect": { "-M1.running": true } }
      ]
    },
    {
      "id": "coilopen-symptom", "name": "Objaw usterki f-k1-coilopen",
      "steps": [
        { "do": "set", "tag": "@fault", "state": { "id": "f-k1-coilopen" } },
        { "do": "set", "tag": "-Q0", "state": { "on": true } },
        { "do": "set", "tag": "-Q1", "state": { "on": true } },
        { "do": "set", "tag": "-F1", "state": { "on": true } },
        { "do": "wait", "ms": 200 },
        { "do": "press", "tag": "-S2", "ms": 200 },
        { "do": "wait", "ms": 500 },
        { "expect": { "-M1.running": false, "-H1.lit": false } }
      ]
    },
    {
      "id": "loto-order", "name": "Procedura LOTO (3 kroki)",
      "steps": [
        { "do": "set", "tag": "-Q0", "state": { "on": true } },
        { "do": "set", "tag": "-Q1", "state": { "on": true } },
        { "do": "set", "tag": "-F1", "state": { "on": true } },
        { "do": "wait", "ms": 100 },
        { "expect": { "-T1.out": true } },
        { "do": "set", "tag": "-Q0", "state": { "on": false } },
        { "do": "lock", "tag": "-Q0" },
        { "expect": { "-Q0.locked": true, "-Q0.on": false } },
        { "do": "measure", "range": "vac", "probes": ["-X1:L1.top", "-X1:L2.top"], "expect": { "value": { "approx": 0, "tol": 0.1 } } },
        { "do": "measure", "range": "vac", "probes": ["-X1:L1.top", "-X1:PE.top"], "expect": { "value": { "approx": 0, "tol": 0.1 } } },
        { "do": "set", "tag": "-Q0", "state": { "on": true } },
        { "expect": { "-Q0.on": false } }
      ]
    }
  ],
  "hints": [
    { "id": "h1", "text": "Włącz układ, uruchom silnik -S2 START, a potem spróbuj zatrzymać -S1 STOP — co działa, co nie?", "level": "subtelna" },
    { "id": "h2", "text": "Jeśli silnik dalej pracuje po STOP, sprawdź czy styk główny -K1 faktycznie się otwiera (mechanicznie).", "level": "bezpośrednia" },
    { "id": "h3", "text": "Styki mogą być zgrzane po zwarciu — wymaga wymiany stycznika. Styk NC przycisku również może się zablokować.", "level": "rozwiązanie" }
  ],
  "scoring": {
    "lotoPenalty": 20,
    "hintLevels": { "subtelna": 3, "bezpośrednia": 8, "rozwiązanie": 20 }
  }
}
