  "requirements": [
    { "id": "r1", "text": "Zabezpieczenie zwarciowe obwodu głównego (-Q1)", "check": "deviceExists", "args": { "tag": "-Q1", "typeKind": "mcb" } },
    { "id": "r2", "text": "Stycznik -K1 z cewką 24 V DC", "check": "deviceExists", "args": { "tag": "-K1", "typeKind": "contactor" } },
    { "id": "r3", "text": "Przekaźnik termiczny -F2 nastawiony na Iₙ silnika", "check": "setting", "args": { "tag": "-F2", "param": "set", "min": 8.2, "max": 8.7 } },
    { "id": "r4", "text": "Obwód sterowania zabezpieczony (-F1) i zasilany z -T1", "check": "inSeries", "args": { "path": ["-Q1:1", "-F1:1", "-F1:2", "-T1:L"] } },
    { "id": "r5", "text": "Samopodtrzymanie przez styk -K1:13–14", "check": "parallel", "args": { "a": "-S2:13", "b": "-S2:14", "with": "-K1:13-14" } },
    { "id": "r6", "text": "Styk -F2:95–96 w obwodzie cewki", "check": "inSeries", "args": { "path": ["-K1:A2", "-F2:95", "-F2:96", "-T1:-"] } },
    { "id": "r7", "text": "Kolory przewodów zgodne z PN-EN 60204-1", "check": "wireColors" },
    { "id": "r8", "text": "Rozruch i zatrzymanie działają", "check": "scenario", "args": { "id": "start-stop" } }
  ],
  "testScenarios": [
    {
      "id": "start-stop", "name": "Rozruch i zatrzymanie",
      "steps": [
        { "do": "set", "tag": "-Q0", "state": { "on": true } },
        { "do": "set", "tag": "-Q1", "state": { "on": true } },
        { "do": "set", "tag": "-F1", "state": { "on": true } },
        { "do": "wait", "ms": 200 },
        { "expect": { "-T1.out": true, "-K1.closed": false, "-M1.running": false } },
        { "do": "press", "tag": "-S2", "ms": 200 },
        { "do": "wait", "ms": 1000 },
        { "expect": { "-K1.closed": true, "-M1.running": true, "-H1.lit": true, "-M1.I": { "approx": 7.8, "tol": 0.3 } } },
        { "do": "measure", "range": "vac", "probes": ["-X1:L1.top", "-X1:N.top"], "expect": { "value": { "approx": 230, "tol": 2 } } },
        { "do": "press", "tag": "-S1", "ms": 200 },
        { "do": "wait", "ms": 100 },
        { "expect": { "-K1.closed": false, "-M1.running": false, "-H1.lit": false } }
      ]
    },
    {
      "id": "overload", "name": "Przeciążenie silnika",
      "steps": [
        { "do": "set", "tag": "-Q0", "state": { "on": true } },
        { "do": "set", "tag": "-Q1", "state": { "on": true } },
        { "do": "set", "tag": "-F1", "state": { "on": true } },
        { "do": "wait", "ms": 200 },
        { "do": "press", "tag": "-S2", "ms": 200 },
        { "do": "wait", "ms": 1000 },
        { "do": "set", "tag": "-M1", "state": { "load": 1.3 } },
        { "do": "wait", "ms": 120000 },
        { "expect": { "-F2.tripped": true, "-K1.closed": false, "-M1.running": false } }
      ]
    },
    {
      "id": "short-l1-n", "name": "Zwarcie L1–N za -Q1 (test silnika)",
      "steps": [
        { "do": "set", "tag": "-Q0", "state": { "on": true } },
        { "do": "set", "tag": "-Q1", "state": { "on": true } },
        { "do": "set", "tag": "@addWire", "state": { "id": "FAULT", "a": "-K1:1", "b": "-X1:N.top", "color": "blue", "cs": 1.5 } },
        { "do": "wait", "ms": 10 },
        { "expect": { "-Q1.tripped": true, "event": "Zwarcie L1–N przez -K1, zadziałał -Q1 (C16) po 4 ms" } }
      ]
    }
  ],
