{
  "$description": "Tokeny projektu Symulator szafy sterowniczej. Jedyne źródło kolorów, typografii i odstępów.",
  "font": {
    "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "size": { "xs": 11, "sm": 12, "md": 14, "lg": 16, "xl": 20, "xxl": 34 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": 1.4
  },
  "radius": { "sm": 4, "md": 8, "lg": 12, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32 },
  "size": { "touchMin": 44, "buttonMain": 48, "topBar": 64, "leftPanel": 272, "rightPanel": 340, "inspector": 560 },
  "theme": {
    "dark": {
      "bg": "#0E1217", "stage": "#0B0F13", "panel": "#141A20", "surface": "#1A2129", "raised": "#212A33",
      "line": "#252E37", "line2": "#33404C",
      "text": "#E7ECF1", "muted": "#9BA8B5",
      "accent": "#4EA8FF", "accentInk": "#08121F", "accentSoft": "rgba(78,168,255,0.14)",
      "shadow": "0 12px 32px rgba(0,0,0,0.45)"
    },
    "light": {
      "bg": "#EEF1F4", "stage": "#E3E8ED", "panel": "#FFFFFF", "surface": "#F3F5F8", "raised": "#FFFFFF",
      "line": "#DCE2E8", "line2": "#C5CED7",
      "text": "#121820", "muted": "#53606C",
      "accent": "#1D6FD8", "accentInk": "#FFFFFF", "accentSoft": "rgba(29,111,216,0.10)",
      "shadow": "0 12px 32px rgba(16,24,32,0.14)"
    }
  },
  "state": {
    "off":  { "color": "#7B8794", "inkDark": "#9BA8B5", "inkLight": "#53606C", "soft": "rgba(123,135,148,0.16)", "label": "Brak napięcia" },
    "on":   { "color": "#F5B53F", "inkDark": "#F5B53F", "inkLight": "#8A5300", "soft": "rgba(245,181,63,0.14)", "label": "Pod napięciem" },
    "flow": { "color": "#3CC7F0", "inkDark": "#3CC7F0", "inkLight": "#0B6F93", "soft": "rgba(60,199,240,0.14)", "dash": "#9BE7FF", "label": "Prąd płynie" },
    "err":  { "color": "#F0564F", "inkDark": "#FF8A84", "inkLight": "#B4232A", "soft": "rgba(240,86,79,0.12)", "label": "Błąd / zwarcie" },
    "trip": { "color": "#A98BFA", "inkDark": "#BBA2FF", "inkLight": "#6D3FD6", "soft": "rgba(169,139,250,0.16)", "stripe2": "#7A5CD6", "label": "Wyzwolony" },
    "ok":   { "color": "#3FCF8E", "inkDark": "#5BDDA1", "inkLight": "#167A50", "soft": "rgba(63,207,142,0.14)", "label": "OK" }
  },
  "wire": {
    "brown":       { "color": "#8A5A2E", "role": "L1" },
    "black":       { "color": "#1D1D1D", "role": "L2" },
    "grey":        { "color": "#8F969D", "role": "L3" },
    "blue":        { "color": "#2D6FE0", "role": "N" },
    "greenYellow": { "color": "#2E9E4F", "stripe": "#F2D02B", "role": "PE" },
    "darkBlue":    { "color": "#2440A8", "role": "DC 24 V" },
    "halo": { "dark": "rgba(255,255,255,0.34)", "light": "rgba(255,255,255,0.75)" },
    "width": { "core": 3.4, "halo": 5.4, "glow": 10 },
    "cornerRadius": 7
  },
  "ferrule": { "0.75": "#9AA3AB", "1": "#D93A3A", "1.5": "#1D1D1D", "2.5": "#2D6FE0" },
  "scene": {
    "dark":  { "plate": "#1F262D", "grid": "#323C46", "duct": "#2A323B", "ductEdge": "#4A5561", "finger": "#3A444F", "rail": "#8A939C", "railSlot": "#5F6872", "dev": "#D3D8DD", "devShade": "#BCC3CA", "devEdge": "#7E8892", "ink": "#11161B", "ink2": "#3B4651", "term": "#D7DCE1", "termEdge": "#4E5964", "block": "#A9B1B9", "blockN": "#3C78D8", "label": "#A3B0BC" },
    "light": { "plate": "#C4CCD3", "grid": "#AEB7C0", "duct": "#EEF1F3", "ductEdge": "#97A2AC", "finger": "#D8DEE3", "rail": "#A0A9B2", "railSlot": "#78828C", "dev": "#FBFCFD", "devShade": "#E3E7EB", "devEdge": "#7F8992", "ink": "#11161B", "ink2": "#46525E", "term": "#E2E6EA", "termEdge": "#56616C", "block": "#B7BEC5", "blockN": "#3C78D8", "label": "#36414C" },
    "scalePxPerMm": 2,
    "gridMm": 9,
    "moduleMm": 18
  },
  "schematic": {
    "dark":  { "paper": "#12171C", "frame": "#3A4550", "grid": "#222B34", "ink": "#D5DCE3", "muted": "#93A0AD", "pe": "#4FBF72" },
    "light": { "paper": "#FFFFFF", "frame": "#9AA4AE", "grid": "#E6EAEE", "ink": "#1A2129", "muted": "#55616D", "pe": "#1F7A3B" },
    "lineWidth": { "power": 1.9, "control": 1.6 },
    "peDash": "10 3 2 3"
  },
  "motion": { "flowDash": "2 12", "flowDurationMs": 900, "pulseDurationMs": 900, "glowBlur": 3 }
}
